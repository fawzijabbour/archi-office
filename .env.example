# Used by docker-compose.yml and docker-compose.prod.yml.
# Copy to .env and fill in — required in production, optional (dev
# fallbacks apply) for local development.

POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string

# Restrict allowed origins in production, e.g. https://yourdomain.com
# Leave unset in development to allow any origin.
CORS_ORIGIN=

# Port the production nginx container listens on (docker-compose.prod.yml)
HTTP_PORT=80

# Optional — email delivery for notifications. Leave blank to skip.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ArchiOffice <no-reply@archioffice.local>
